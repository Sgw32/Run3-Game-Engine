attr /sequence/adents[0]/npc[2] @name="guard"
attr /sequence/adents[0]/npc[2] @velocity="110"
node /sequence/adents[0]/npc[2]/position[0] line=6
attr /sequence/adents[0]/npc[2]/position[0] @x="0"
attr /sequence/adents[0]/npc[2]/position[0] @y="1"
attr /sequence/adents[0]/npc[2]/position[0] @z="2"
node /sequence/events[1] line=9
