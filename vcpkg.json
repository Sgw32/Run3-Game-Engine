{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "run3-engine",
  "version-string": "0.1.0",
  "description": "Pinned dependencies for the Run3 modernization build",
  "license": "MIT",
  "builtin-baseline": "04a9d8e5212d01ee1dd9478eadd9caade4f8b0d4",
  "dependencies": [
    "bullet3",
    "catch2",
    "lua",
    "miniaudio",
    "nlohmann-json",
    {
      "name": "ogre",
      "default-features": false,
      "features": [
        "overlay",
        "tools",
        "zip"
      ]
    },
    "tinyxml2"
  ],
  "overrides": [
    {
      "name": "bullet3",
      "version": "3.25",
      "port-version": 3
    },
    {
      "name": "lua",
      "version": "5.4.8"
    },
    {
      "name": "miniaudio",
      "version": "0.11.25"
    },
    {
      "name": "ogre",
      "version": "14.5.2"
    }
  ]
}
